{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "commonjs",
    "typeRoots": [
      "./types"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-renderer",
    "src/renderer",
    "vite.renderer.config.mts",
    "vitest.config.mts",
    "test"
  ]
}
