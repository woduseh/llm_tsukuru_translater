{
  "name": "llm-tsukuru-translater",
  "version": "3.3.0",
  "description": "LLM Tsukuru Translater",
  "main": "dist-main/main.js",
  "scripts": {
    "start": "electron .",
    "dev:renderer": "vite --config vite.renderer.config.mts",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "node scripts/dev.cjs",
    "doctor": "node scripts/doctor.cjs",
    "typecheck:main": "node node_modules/@typescript/native/bin/tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "vue-tsc -p tsconfig.renderer.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build:ts": "node scripts/clean-main.cjs && node node_modules/@typescript/native/bin/tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build:app": "npm run build:renderer && npm run build:ts && npm run build:mcp",
    "prestart": "npm run build:app",
    "dist:portable": "npm run build:app && electron-builder --windows portable:x64",
    "dist:installer": "npm run build:app && electron-builder --windows nsis:x64",
    "dist:all": "npm run build:app && electron-builder --windows --x64",
    "lint": "eslint \"src/**/*.ts\" \"src/renderer/**/*.vue\" \"main.ts\"",
    "test": "npm run test:tooling && vitest run",
    "test:coverage": "npm run test:tooling && vitest run --coverage",
    "test:tooling": "node --test --experimental-test-isolation=none test/tooling/*.test.cjs",
    "test:watch": "vitest",
    "verify": "node scripts/verify.cjs",
    "verify:plan": "node scripts/verify.cjs --plan",
    "verify:full": "node scripts/verify.cjs --full",
    "harness:core": "node scripts/harness/core.cjs",
    "harness:eval": "node scripts/harness/eval.cjs",
    "harness:ui": "node scripts/harness/ui.cjs",
    "harness:live": "node scripts/harness/live.cjs",
    "harness:package-smoke": "node scripts/harness/package-smoke.cjs",
    "build:mcp": "node scripts/build-mcp-server.mjs"
  },
  "author": "Jackdu",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "encoding-japanese": "^2.4.0",
    "fast-csv": "^5.0.7",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "google-auth-library": "^11.1.0",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.4.2",
    "node-pty": "^1.1.0",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "@electron/rebuild": {
      "node-gyp": "^12.1.0"
    }
  },
  "build": {
    "productName": "LLM Tsukuru Translater",
    "appId": "net.electron.LlmTsukuruTranslater",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "dist-main/**",
      "dist-renderer/**",
      "res/**",
      "package.json",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/*.ts.map",
      "!test/**",
      "!src/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "./res/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "./dist/"
    }
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
